#!/bin/bash
# Secure Binary Wrapper - Robust Version

set -e

DECRYPT_KEY="067a6da8145d9be19b6cca8528438a99583f5da216b2e2785f1a467687989d6d"

# Debug function
debug_msg() {
    if [ "$DEBUG_WRAPPER" = "1" ]; then
        echo "[DEBUG] $1" >&2
    fi
}

# Find payload marker
PAYLOAD_START=$(grep -n "^__ENCRYPTED_PAYLOAD__$" "$0" | cut -d: -f1)
if [ -z "$PAYLOAD_START" ]; then
    echo "[-] Error: Payload marker not found!" >&2
    exit 1
fi

debug_msg "Payload starts at line: $PAYLOAD_START"

# Create temp directory
TEMP_DIR=$(mktemp -d)
trap "rm -rf $TEMP_DIR" EXIT

PAYLOAD_FILE="$TEMP_DIR/payload.enc"
DECRYPTED_BINARY="$TEMP_DIR/binary"

# Extract payload
debug_msg "Extracting encrypted payload..."
tail -n +$((PAYLOAD_START + 1)) "$0" > "$PAYLOAD_FILE"

debug_msg "Payload size: $(wc -c < "$PAYLOAD_FILE") bytes"

# Decrypt
debug_msg "Decrypting with OpenSSL..."
if ! echo "$DECRYPT_KEY" | openssl enc -aes-256-cbc -d -salt -pbkdf2 -iter 100000 \
     -in "$PAYLOAD_FILE" -out "$DECRYPTED_BINARY" -base64 -A -pass stdin 2>/dev/null; then
    
    # Try alternative method without -A flag
    debug_msg "Retrying with alternative method..."
    if ! echo "$DECRYPT_KEY" | openssl enc -aes-256-cbc -d -salt -pbkdf2 -iter 100000 \
         -in "$PAYLOAD_FILE" -out "$DECRYPTED_BINARY" -base64 -pass stdin 2>/dev/null; then
        
        # Try without pbkdf2 (for older OpenSSL)
        debug_msg "Trying legacy decryption method..."
        if ! echo "$DECRYPT_KEY" | openssl enc -aes-256-cbc -d -salt \
             -in "$PAYLOAD_FILE" -out "$DECRYPTED_BINARY" -base64 -pass stdin 2>/dev/null; then
            echo "[-] All decryption methods failed!" >&2
            echo "[-] OpenSSL version: $(openssl version)" >&2
            exit 1
        fi
    fi
fi

# Verify decryption
if [ ! -s "$DECRYPTED_BINARY" ]; then
    echo "[-] Decrypted file is empty!" >&2
    exit 1
fi

debug_msg "Decrypted size: $(wc -c < "$DECRYPTED_BINARY") bytes"

# Make executable and run
chmod +x "$DECRYPTED_BINARY"
exec "$DECRYPTED_BINARY" "$@"

__ENCRYPTED_PAYLOAD__
