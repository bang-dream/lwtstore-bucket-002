#!/bin/bash
# Secure Binary Wrapper - Protected Execution Environment
# This wrapper contains encrypted binary payload

# Decryption key (will be embedded)
DECRYPT_KEY="15c32a01cda3d5042725333459e3152f74f0eb0529f862e4b1534318e661b8d8"

# Create temporary directory for execution
TEMP_DIR=$(mktemp -d)
PAYLOAD_FILE="$TEMP_DIR/payload"
DECRYPTED_BINARY="$TEMP_DIR/decrypted.bin"

# Extract encrypted payload from this script
sed -n '/^__ENCRYPTED_PAYLOAD__$/,$p' "$0" | tail -n +2 > "$PAYLOAD_FILE"

# Decrypt the payload
echo "[*] Decrypting binary payload..." >&2
if ! echo "$DECRYPT_KEY" | openssl enc -aes-256-cbc -d -pbkdf2 -iter 100000 -in "$PAYLOAD_FILE" -out "$DECRYPTED_BINARY" -base64 -pass stdin 2>/dev/null; then
    echo "[-] Decryption failed!" >&2
    rm -rf "$TEMP_DIR"
    exit 1
fi

# Make decrypted binary executable
chmod +x "$DECRYPTED_BINARY"

# Execute the decrypted binary with all arguments
echo "[*] Executing protected binary..." >&2
"$DECRYPTED_BINARY" "$@"
EXIT_CODE=$?

# Cleanup
rm -rf "$TEMP_DIR"

exit $EXIT_CODE

